{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L.o.S.A. - Launcher of Spark Anvil",
  "version": "0.5.0",
  "identifier": "com.losa.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "L.o.S.A. — Launcher of Spark Anvil",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://piston-meta.mojang.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {"nsis":{"displayLanguageSelector":false,"installMode":"currentUser"}}
  }
}